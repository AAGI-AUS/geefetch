linters: linters_with_defaults(
    line_length_linter = line_length_linter(100L),
    object_name_linter = object_name_linter(styles = c("snake_case", "dotted.case", "symbols")),
    indentation_linter = NULL,
    commented_code_linter = NULL,
    object_usage_linter = NULL,
    cyclocomp_linter = cyclocomp_linter(complexity_limit = 25L)
  )
exclusions: list(
    "tests/testthat.R",
    "vignettes"
  )
encoding: "UTF-8"
